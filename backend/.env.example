# 后端环境变量模板（复制为 .env 填入真实值）
# 生成 JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# 服务监听端口
PORT=3001

# 绑定网卡（0.0.0.0 = 接受所有网络接口；本地开发用 127.0.0.1 更安全）
HOST=0.0.0.0

# SQLite 数据库文件路径
DATABASE_URL="file:./dev.db"

# JWT 签名密钥（⚠️ 必须保密；泄露 = 攻击者可伪造任意用户 token）
JWT_SECRET=replace-me-with-64-char-hex-random-string

# CORS 白名单（多个 origin 用英文逗号分隔）
# 生产: https://your-domain.com
# 本地: http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# 反向代理层数（按实际 Nginx/Cloudflare/CDN 层数调整）
# 0 = 直连无反代；1 = 一层反代；N = 信任前 N 层代理的 X-Forwarded-For
TRUST_PROXY_HOPS=1
